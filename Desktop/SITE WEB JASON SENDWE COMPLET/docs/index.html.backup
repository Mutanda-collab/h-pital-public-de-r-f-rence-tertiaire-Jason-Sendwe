	<!-- Inline CSS pour l'animation -->
	<style>
	  @keyframes scroll {
		0% { transform: translateX(0); }
		100% { transform: translateX(-50%); }
	  }
    /* Pause animation when user interacts */
    #departmentsCarousel.paused { animation-play-state: paused; }
	</style>

  <script>
    (function() {
      const viewport = document.querySelector('.section.about .row.align-items-center');
      const inner = document.getElementById('departmentsCarousel');
      function pauseResume() {
        if (!inner) return;
        inner.classList.add('paused');
        clearTimeout(window.__servicesPauseTimer);
        window.__servicesPauseTimer = setTimeout(() => inner.classList.remove('paused'), 4000);
      }
      window.nextServices = function() {
        if (!viewport) return;
        pauseResume();
        viewport.scrollBy({ left: 320, behavior: 'smooth' });
      };
      window.prevServices = function() {
        if (!viewport) return;
        pauseResume();
        viewport.scrollBy({ left: -320, behavior: 'smooth' });
      };
    })();
  </script>
		
  </section>
  

<section class="section appoinment" style="position: relative; padding-top: 20px; z-index: 1000; background-color: #02183f; color: white;">
