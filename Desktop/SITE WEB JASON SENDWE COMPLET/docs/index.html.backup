<section class="section appoinment" style="background-color: #7e7e7e80; padding: 40px 0; position: relative; padding-top: 20px; z-index: 1000;">
		
		<div class="container">
			
		  <div class="row align-items-center">

			<div class="col-lg-6 col-md-10">
				<div class="appoinment-wrap mt-5 mt-lg-0" style="position: relative; overflow: hidden;">
				  
				  <!-- Bouton Événements -->
				  <a href="evenement.html" class="btn btn-main btn-round-full" style="position: absolute; top: 0; right: 0; background-color: #ec0451; z-index: 1000; border-radius: 5px;">Événements</a>
			  
				  <!-- Titre -->
				  <h5 class="mb-2 title-color" style="margin-top:40px;">Latest @ HPRT-JS</h5>
				  <h2 class="mb-2 title-color" style="color: #0984db; z-index: 1000;">Events Calender</h2>
			  
				  <!-- Slider des événements -->
				  <div id="eventSlider" style="position: relative; width:100%; height:auto;">
					<div class="event-slide" style="padding:20px; border:1px solid #ddd; border-radius:10px; background:#f9f9f9;">
			  
					  <!-- Date -->
					  <div style="display:flex; align-items:center; margin-bottom:10px;">
						<div style="text-align:center; border:1px solid #ccc; border-radius:8px; padding:8px; margin-right:15px;">
						  <div style="font-size:20px; font-weight:bold; color:#ec0451;">10</div>
						  <div style="font-size:14px; color:#555;">Feb</div>
						</div>
						<h4 style="margin:0; font-size:16px; font-weight:bold;">
						  VERS LA MATÉRIALISATION D'UN PONT MÉDICAL SUR LE FLEUVE CONGO, HJ HOSPITALS (RDC) – CLINIQUE SECUREX (CONGO BZV)
						</h4>
					  </div>
			  
					  <!-- Texte -->
					  <p style="font-size:14px; color:#333; margin-bottom:10px;">
						La Direction de HJ Hospitals et ses homologues de la Clinique Securex de Brazzaville, lors d'une brève réunion le 10 février 2021.
					  </p>
			  
					  <!-- Lieux et lien -->
					  <div style="font-size:14px; margin-bottom:8px;">
						📍 Brazzaville &nbsp;&nbsp; 🗺️ Get Direction
					  </div>
					  <a href="#" style="color:#0984db; font-weight:bold; text-decoration:none;">Voir les détails</a>
					</div>
				  </div>
			  
				  <!-- Contrôles -->
				  <div style="text-align:center; margin-top:10px;">
					<button onclick="prevEvent()" style="background:none; border:none; font-size:20px; cursor:pointer;">&#8592;</button>
					<button onclick="nextEvent()" style="background:none; border:none; font-size:20px; cursor:pointer;">&#8594;</button>
				  </div>
			  
				</div>
			  </div>
			  
			  <script>
				let currentEvent = 0;
				const events = [
				  `<div class="event-slide" style="padding:20px; border:1px solid #ddd; border-radius:10px; background:#f9f9f9; transition: all 0.5s ease;">
					<div style="display:flex; align-items:center; margin-bottom:10px;">
					  <div style="text-align:center; border:1px solid #ccc; border-radius:8px; padding:8px; margin-right:15px;">
						<div style="font-size:20px; font-weight:bold; color:#ec0451;">17</div>
						<div style="font-size:14px; color:#555;">Sep</div>
					  </div>
					  <h4 style="margin:0; font-size:16px; font-weight:bold;">
						JOURNÉE MONDIALE DE LA SÉCURITÉ DES PATIENTS
					  </h4>
					</div>
					<p style="font-size:14px; color:#333; margin-bottom:10px;">
					  Thème : « Sécurité des soins dès le début : assurer des soins sûrs pour chaque nouveau-né et chaque enfant »
					</p>
					<div style="font-size:14px; margin-bottom:8px;">📍 Monde entier &nbsp;&nbsp; 🗺️ Get Direction</div>
					<a href="#" style="color:#0984db; font-weight:bold; text-decoration:none;">Voir les détails</a>
				  </div>`,
			  
				  `<div class="event-slide" style="padding:20px; border:1px solid #ddd; border-radius:10px; background:#f9f9f9; transition: all 0.5s ease;">
					<div style="display:flex; align-items:center; margin-bottom:10px;">
					  <div style="text-align:center; border:1px solid #ccc; border-radius:8px; padding:8px; margin-right:15px;">
						<div style="font-size:20px; font-weight:bold; color:#ec0451;">18</div>
						<div style="font-size:14px; color:#555;">Aout</div>
					  </div>
					  <h4 style="margin:0; font-size:16px; font-weight:bold;">
						FORMATION DU PERSONNEL MÉDICAL SUR LA PRISE EN CHARGE DES URGENCES
					  </h4>
					</div>
					<p style="font-size:14px; color:#333; margin-bottom:10px;">
					  Une session de formation intensive a été organisée pour renforcer les capacités des médecins urgentistes de l’hôpital.
					</p>
					<div style="font-size:14px; margin-bottom:8px;">📍 Lubumbashi &nbsp;&nbsp; 🗺️ Get Direction</div>
					<a href="#" style="color:#0984db; font-weight:bold; text-decoration:none;">Voir les détails</a>
				  </div>`
				];
			  
				function showEvent(index) {
				  const slider = document.getElementById("eventSlider");
				  slider.style.opacity = 0; // fade out
				  setTimeout(() => {
					slider.innerHTML = events[index];
					slider.style.opacity = 1; // fade in
				  }, 200);
				}
			  
				function nextEvent() {
				  currentEvent = (currentEvent + 1) % events.length;
				  showEvent(currentEvent);
				}
			  
				function prevEvent() {
				  currentEvent = (currentEvent - 1 + events.length) % events.length;
				  showEvent(currentEvent);
				}
			  
				// Initialisation
				showEvent(currentEvent);
			  
				// Défilement automatique rapide (toutes les 2s)
				setInterval(nextEvent, 4000);
			  </script>
			  
			  
			  
			<div class="col-lg-6">
			  <div class="appoinment-content">

				<div class="doctor-img">
						<iframe 
					  width="100%" 
					  height="450" 
					  src="https://www.youtube.com/embed/tR2FMDuKKX4?si=Co48kDsyJm4X3w7k&amp;controls=0" 
					  title="YouTube video player" 
					  frameborder="0" 
					  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
						  allowfullscreen
						  loading="lazy"
						  referrerpolicy="strict-origin-when-cross-origin"
						  style="border-radius:15px; overflow:hidden;">
					</iframe>
				  </div>
				  
			  </div>
			</div>
			
		  </div>
		</div>
</section>


