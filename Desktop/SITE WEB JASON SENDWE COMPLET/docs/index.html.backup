		  ◀ Précédent
		</button>
		<button type="button" onclick="nextServices()" style="
		  background: #00bfff; 
		  color: white; 
		  border: 2px solid #00bfff; 
		  padding: 12px 24px; 
		  border-radius: 25px; 
		  font-weight: bold;
		  cursor: pointer;
		  transition: all 0.3s ease;
		" onmouseover="this.style.background='#02183f'; this.style.borderColor='#02183f';" onmouseout="this.style.background='#00bfff'; this.style.borderColor='#00bfff';">
