			  <div class="carousel-item active">
				<div class="row" style="margin-top: -50px;">
		  
				  <!-- Fiche Santé Vision -->
				  <div class="col-lg-4 col-md-6">
					<div class="department-block mb-5" style="border-top: 8px solid rgb(0, 195, 255);">
					  <img src="images/service/service-1.jpg" alt="Santé des yeux" class="img-fluid w-100" loading="lazy" decoding="async">
					  <div class="content">
						<h4 class="mt-4 mb-2 title-color" style="color: rgb(255, 0, 0);">Comment prévenir la fatigue visuelle ?</h4>
						<p class="mb-2" style="font-size: 14px; color: gray;">
						  <i class="fas fa-calendar-alt"></i> 22 Septembre 2025 
						  &nbsp; | &nbsp; 
						  <i class="fas fa-user-md"></i> Dr. Sandra Mpungu
						</p>
						<p class="mb-4">
						  Les écrans sollicitent énormément nos yeux. Découvrez les gestes simples pour réduire la sécheresse oculaire et protéger votre vision au quotidien.
						</p>
                        <a href="blog-fatigue-visuelle.html" class="read-more"
						   style="display:inline-block; background-color: #ff0707; color: white; padding: 6px 14px; border-radius: 4px; text-decoration: none; font-weight: 500; transition:all 0.3s ease; transform:scale(1);"
						   onmouseover="this.style.background='#00bfff';this.style.transform='scale(1.1)';" 
						   onmouseout="this.style.background='#ff0707';this.style.transform='scale(1)';">
						  Lire Plus <i class="icofont-simple-right ml-2"></i>
						</a>
					  </div>
					</div>
				  </div>
		  
				  <!-- Fiche Santé Bucco-dentaire -->
				  <div class="col-lg-4 col-md-6">
