    <script src="plugins/bootstrap/bootstrap.min.js" defer></script>
    <script src="plugins/slick-carousel/slick/slick.min.js" defer></script>
    <script src="plugins/shuffle/shuffle.min.js" defer></script>

    <!-- Google Map -->
    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyAkeLMlsiwzp6b3Gnaxd86lvakimwGA6UA" defer></script>
    <script src="plugins/google-map/gmap.js" defer></script>
<!-- ✅ Swiper JS -->
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>

<!-- ✅ Script d'initialisation (sécurisé après chargement) -->
<script>
  (function initSwiperWhenReady(){
    function setup(){
      if (!window.Swiper) return false;
      var el = document.querySelector('.mySwiper');
      if (!el) return false;
      try {
        new Swiper('.mySwiper', {
          loop: true,
          speed: 1200,
          autoplay: { delay: 5000, disableOnInteraction: false },
          navigation: { nextEl: '.swiper-button-next', prevEl: '.swiper-button-prev' },
          pagination: { el: '.swiper-pagination', clickable: true },
        });
        return true;
      } catch(e) { return false; }
    }
    if (setup()) return;
    document.addEventListener('DOMContentLoaded', function(){
      if (setup()) return;
      var tries = 0;
      var t = setInterval(function(){
        tries++;
        if (setup() || tries > 40) clearInterval(t);
      }, 100);
    });
  })();
  </script>

	  
	
	
    
    <script src="js/script.js" defer></script>

  </body>
  </html>
